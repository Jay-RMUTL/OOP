import java.util.Scanner;

class ConnectionSimulator {
    private String serverName;
    private boolean isOnline;

    public ConnectionSimulator(String serverName) {
        this.serverName = serverName;
        this.isOnline = false;
    }

    public boolean isOnline() {
        return this.isOnline;
    }

    public void activateConnection() {
        if (!this.isOnline) {
            this.isOnline = true;
            System.out.println("Connection established to " + this.serverName);
        } else {
            System.out.println("Session is already active.");
        }
    }

    public void closeConnection() {
        if (this.isOnline) {
            this.isOnline = false;
            System.out.println("Connection closed successfully.");
        } else {
            System.out.println("The connection is already terminated.");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner inputReader = new Scanner(System.in);

        String serverInput = inputReader.nextLine();
        
        inputReader.close(); 
        
        ConnectionSimulator myConnection = new ConnectionSimulator(serverInput);

        myConnection.activateConnection();
        myConnection.closeConnection();
        myConnection.closeConnection(); 

        System.out.println(myConnection.isOnline());
    }
}
