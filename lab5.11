import java.util.Scanner;

class Document {
    protected String title;

    public Document(String title) {
        this.title = title;
    }

    public void displayDetails() {
        System.out.println("Document: " + title);
    }
}

class TextDocument extends Document {
    protected int wordCount;

    public TextDocument(String title, int wordCount) {
        super(title);
        this.wordCount = wordCount;
    }

    @Override
    public void displayDetails() {
        System.out.println("Text: " + title + ", Words: " + wordCount);
    }
}

class PDFDocument extends Document {
    protected int pageCount;

    public PDFDocument(String title, int pageCount) {
        super(title);
        this.pageCount = pageCount;
    }

    @Override
    public void displayDetails() {
        System.out.println("PDF: " + title + ", Pages: " + pageCount);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Document[] docs = new Document[4];

        docs[0] = new TextDocument(sc.nextLine(), Integer.parseInt(sc.nextLine()));
        docs[1] = new PDFDocument(sc.nextLine(), Integer.parseInt(sc.nextLine()));
        docs[2] = new TextDocument(sc.nextLine(), Integer.parseInt(sc.nextLine()));
        docs[3] = new PDFDocument(sc.nextLine(), Integer.parseInt(sc.nextLine()));

        int totalPages = 0;
        for (Document doc : docs) {
            if (doc instanceof PDFDocument) {
                PDFDocument pdf = (PDFDocument) doc;
                totalPages += pdf.pageCount;
            }
        }

        for (Document doc : docs) {
            doc.displayDetails();
        }
        System.out.println("Total Pages: " + totalPages);

        sc.close();
    }
}
