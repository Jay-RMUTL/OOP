import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

class BankAccount {
    private double balance;
    private static int totalTransactionCount = 0;

    public static void resetTotalTransactionCount() {
        totalTransactionCount = 0;
    }

    public BankAccount(double initialDeposit) {
        this.balance = (initialDeposit >= 0) ? initialDeposit : 0;
    }

    public String deposit(double amount) {
        if (amount > 0) {
            this.balance += amount;
            totalTransactionCount++;
            return "Deposit successful.";
        } else {
            return "Invalid amount.";
        }
    }

    public String withdraw(double amount) {
        if (amount > 0) {
            if (amount <= this.balance) {
                this.balance -= amount;
                totalTransactionCount++;
                return "Withdrawal successful.";
            } else {
                return "Insufficient funds.";
            }
        } else {
            return "Invalid amount.";
        }
    }

    public double getBalance() {
        return this.balance;
    }

    public static int getTotalTransactionCount() {
        return totalTransactionCount;
    }
    
    public String getCreationMessage() {
        return "Account created.";
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        List<String> outputResults = new ArrayList<>();
        
        List<String> allInputs = new ArrayList<>();
        
        if (!scanner.hasNextInt()) {
            scanner.close();
            return;
        }
        int N = scanner.nextInt();
        scanner.nextLine();

        for (int i = 0; i < N; i++) {
            if (!scanner.hasNextLine()) break;
            String command = scanner.nextLine().trim();
            allInputs.add(command);
            
            if (command.equals("CREATE") || command.equals("DEPOSIT") || command.equals("WITHDRAW")) {
                if (scanner.hasNextLine()) {
                    String value = scanner.nextLine().trim();
                    allInputs.add(value);
                } else {
                    allInputs.add("MISSING_VALUE"); 
                }
            }
        }
        scanner.close();

        BankAccount myAccount = null;
        BankAccount.resetTotalTransactionCount();
        
        int inputIndex = 0;
        while (inputIndex < allInputs.size()) {
            String command = allInputs.get(inputIndex++);
            
            switch (command) {
                case "CREATE":
                    String depositStr = allInputs.get(inputIndex++);
                    try {
                        double initialDeposit = Double.parseDouble(depositStr);
                        myAccount = new BankAccount(initialDeposit);
                        outputResults.add(myAccount.getCreationMessage());
                    } catch (NumberFormatException e) { }
                    break;

                case "DEPOSIT":
                case "WITHDRAW":
                    String amountStr = allInputs.get(inputIndex++);
                    
                    if (myAccount == null) {
                        outputResults.add("No account exists.");
                    } else {
                        try {
                            double amount = Double.parseDouble(amountStr);
                            if (command.equals("DEPOSIT")) {
                                outputResults.add(myAccount.deposit(amount));
                            } else {
                                outputResults.add(myAccount.withdraw(amount));
                            }
                        } catch (NumberFormatException e) { }
                    }
                    break;

                case "STATUS":
                    if (myAccount != null) {
                        outputResults.add(String.format("Balance: %.1f", myAccount.getBalance()));
                    } else {
                        outputResults.add("No account exists.");
                    }
                    break;

                case "GLOBAL STATUS":
                    outputResults.add("Total Transactions: " + BankAccount.getTotalTransactionCount());
                    break;
            }
        }

        for (String result : outputResults) {
            System.out.println(result);
        }
    }
}
