import java.util.Scanner;

class SystemConfig {

    private static SystemConfig instance;
    private String serverUrl;
    private int maxConnections;

    private SystemConfig() {
        this.serverUrl = "default.server.com";
        this.maxConnections = 10;
        System.out.println("SystemConfig: New instance created (Singleton initialization).");
    }

    public static SystemConfig getInstance() {
        if (instance == null) {
            instance = new SystemConfig();
        }
        return instance;
    }

    public String getServerUrl() {
        return serverUrl;
    }

    public int getMaxConnections() {
        return maxConnections;
    }

    public void setServerUrl(String url) {
        this.serverUrl = url;
    }

    public void setMaxConnections(int count) {
        if (count > 0) {
            this.maxConnections = count;
            System.out.println("Max connections set.");
        } else {
            System.out.println("Invalid count.");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        if (!scanner.hasNextInt()) {
            scanner.close();
            return;
        }
        int N = scanner.nextInt();
        scanner.nextLine(); 

        for (int i = 0; i < N; i++) {
            String command = scanner.nextLine().trim();
            SystemConfig config = SystemConfig.getInstance();

            if (command.equals("SET URL")) {
                String newUrl = scanner.nextLine().trim();
                config.setServerUrl(newUrl);

            } else if (command.equals("SET MAX")) {
                if (scanner.hasNextInt()) {
                    int newMax = scanner.nextInt();
                    config.setMaxConnections(newMax);
                    scanner.nextLine(); 
                } else {
                    if (scanner.hasNextLine()) scanner.nextLine();
                }

            } else if (command.equals("SHOW")) {
                System.out.println("URL: " + config.getServerUrl());
                System.out.println("MAX: " + config.getMaxConnections());
            } 
        }

        scanner.close();
    }
}
